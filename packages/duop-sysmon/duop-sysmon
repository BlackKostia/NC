#!/usr/bin/env python3
"""duop-sysmon: Modern TrueColor System Monitor package for Duop."""

from __future__ import annotations

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from duop_tui_kit import (
    RawTerminal,
    Theme,
    braille_graph,
    draw_box,
    format_bytes,
    format_uptime,
    merge_columns,
    pad_right,
    progress_bar,
    sparkline,
    styled,
    truncate,
)
from sys_telemetry import (
    CpuSampler,
    ProcessSampler,
    read_disks,
    read_memory,
    read_system_info,
)


def _render_header(width: int, info, sort_by: str) -> str:
    left = (
        styled(" ◆ duop-sysmon ", fg=Theme.BG, bg=Theme.ACCENT, bold=True)
        + " "
        + styled(info.hostname, fg=Theme.CYAN, bold=True)
        + styled(f"  kernel {info.kernel}", fg=Theme.MUTED)
    )
    right = (
        styled("up ", fg=Theme.MUTED)
        + styled(format_uptime(info.uptime_sec), fg=Theme.GREEN, bold=True)
        + styled("  load ", fg=Theme.MUTED)
        + styled(f"{info.load_1m:.2f} {info.load_5m:.2f} {info.load_15m:.2f}", fg=Theme.TEXT)
        + styled(f"  sort:{sort_by.upper()}", fg=Theme.PURPLE, bold=True)
    )
    gap = max(1, width - len(truncate(left, width)) - 0)
    # Use visible lengths via pad_right on left, then append right if space permits
    from duop_tui_kit import visible_len

    rem = width - visible_len(left) - visible_len(right)
    if rem >= 1:
        return left + (" " * rem) + right
    return truncate(left + " " + right, width)


def _render_cpu_box(width: int, cpu: CpuSampler, info) -> list[str]:
    inner_w = max(20, width - 4)
    lines: list[str] = []
    model_short = info.cpu_model.replace("(R)", "").replace("(TM)", "").strip()
    lines.append(
        styled(truncate(model_short, inner_w - 14), fg=Theme.TEXT, bold=True)
        + "  "
        + styled(f"{info.cores} threads", fg=Theme.CYAN)
    )
    lines.append(
        styled("Total ", fg=Theme.MUTED)
        + progress_bar(cpu.total_pct, inner_w - 6, show_pct=True)
    )
    graph_lines = braille_graph(cpu.history, inner_w, height=3)
    lines.extend(graph_lines)

    # Render per-core compact bars (2 columns if wide enough)
    per_core = cpu.per_core
    if per_core:
        cols = 2 if inner_w >= 44 and len(per_core) > 4 else 1
        cell_w = (inner_w - (2 if cols == 2 else 0)) // cols
        shown = per_core[:16]
        for idx in range(0, len(shown), cols):
            row_parts: list[str] = []
            for c in range(cols):
                if idx + c < len(shown):
                    core_id = idx + c
                    pct = shown[core_id]
                    label = styled(f"C{core_id:<2d}", fg=Theme.MUTED)
                    bar = progress_bar(pct, max(8, cell_w - 4), show_pct=True)
                    row_parts.append(pad_right(label + " " + bar, cell_w))
            lines.append("  ".join(row_parts))

    return draw_box(
        "CPU",
        lines,
        width=width,
        border_color=Theme.BORDER_FOCUS,
        title_color=Theme.CYAN,
        subtitle=f"{info.procs_running}/{info.procs_total} run",
    )


def _render_mem_box(width: int, mem) -> list[str]:
    inner_w = max(20, width - 4)
    lines: list[str] = []
    ram_info = f"{format_bytes(mem.ram_used)} / {format_bytes(mem.ram_total)}"
    lines.append(
        styled("RAM  ", fg=Theme.TEXT, bold=True)
        + styled(ram_info, fg=Theme.CYAN)
    )
    lines.append(progress_bar(mem.ram_pct, inner_w, show_pct=True))

    swap_info = (
        f"{format_bytes(mem.swap_used)} / {format_bytes(mem.swap_total)}"
        if mem.swap_total > 0
        else "disabled"
    )
    lines.append(
        styled("Swap ", fg=Theme.TEXT, bold=True)
        + styled(swap_info, fg=Theme.PURPLE)
    )
    lines.append(progress_bar(mem.swap_pct, inner_w, show_pct=True))
    lines.append(
        styled("Cache/Buf: ", fg=Theme.MUTED)
        + styled(format_bytes(mem.cached), fg=Theme.TEXT)
        + styled("  Avail: ", fg=Theme.MUTED)
        + styled(format_bytes(mem.ram_available), fg=Theme.GREEN)
    )
    return draw_box(
        "RAM & SWAP",
        lines,
        width=width,
        border_color=Theme.BORDER,
        title_color=Theme.PURPLE,
    )


def _render_disk_box(width: int, disks) -> list[str]:
    inner_w = max(20, width - 4)
    lines: list[str] = []
    if not disks:
        lines.append(styled("No mounted block filesystems found", fg=Theme.MUTED))
    else:
        for d in disks[:5]:
            mp = truncate(d.mountpoint, max(8, inner_w - 26))
            sizes = f"{format_bytes(d.used)}/{format_bytes(d.total)}"
            header = (
                styled(mp, fg=Theme.TEXT, bold=True)
                + styled(f" ({d.fstype})", fg=Theme.MUTED)
                + "  "
                + styled(sizes, fg=Theme.CYAN)
            )
            lines.append(header)
            lines.append(progress_bar(d.pct, inner_w, show_pct=True))
    return draw_box(
        "DISK",
        lines,
        width=width,
        border_color=Theme.BORDER,
        title_color=Theme.YELLOW,
    )


def _render_proc_box(width: int, procs, sort_by: str) -> list[str]:
    inner_w = max(30, width - 4)
    name_w = max(12, inner_w - 32)
    header = styled(
        f"{'PID':>7}  {'S':<1}  {'CPU%':>6}  {'MEM%':>6}  {'RSS':>9}  {'COMMAND':<{name_w}}",
        fg=Theme.ACCENT,
        bold=True,
    )
    lines = [header]
    for p in procs:
        cpu_color = Theme.RED if p.cpu_pct >= 50.0 else (Theme.YELLOW if p.cpu_pct >= 15.0 else Theme.GREEN)
        row = (
            styled(f"{p.pid:>7}", fg=Theme.MUTED)
            + "  "
            + styled(f"{p.state:<1}", fg=Theme.CYAN)
            + "  "
            + styled(f"{p.cpu_pct:5.1f}%", fg=cpu_color)
            + "  "
            + styled(f"{p.mem_pct:5.1f}%", fg=Theme.PURPLE)
            + "  "
            + styled(f"{format_bytes(p.rss_bytes):>9}", fg=Theme.TEXT)
            + "  "
            + styled(truncate(p.name, name_w), fg=Theme.TEXT)
        )
        lines.append(row)
    return draw_box(
        "PROCESSES",
        lines,
        width=width,
        border_color=Theme.BORDER,
        title_color=Theme.GREEN,
        subtitle=f"by {sort_by}",
    )


def _render_footer(width: int, cpu_history) -> str:
    keys = (
        styled(" q/Esc ", fg=Theme.BG, bg=Theme.RED, bold=True)
        + styled(" Quit  ", fg=Theme.MUTED)
        + styled(" c ", fg=Theme.BG, bg=Theme.CYAN, bold=True)
        + styled(" CPU  ", fg=Theme.MUTED)
        + styled(" m ", fg=Theme.BG, bg=Theme.PURPLE, bold=True)
        + styled(" MEM  ", fg=Theme.MUTED)
        + styled(" p ", fg=Theme.BG, bg=Theme.YELLOW, bold=True)
        + styled(" PID  ", fg=Theme.MUTED)
        + styled(" r ", fg=Theme.BG, bg=Theme.GREEN, bold=True)
        + styled(" Refresh ", fg=Theme.MUTED)
    )
    sp = sparkline(cpu_history, max(8, min(24, width - 58)))
    return truncate(keys + " " + sp, width)


def build_frame(
    width: int,
    height: int,
    cpu: CpuSampler,
    proc_sampler: ProcessSampler,
    sort_by: str,
) -> str:
    width = max(60, width)
    info = read_system_info()
    cpu.sample()
    mem = read_memory()
    disks = read_disks()
    proc_limit = max(4, min(14, height - 20)) if height > 22 else 6
    procs = proc_sampler.sample(mem.ram_total, limit=proc_limit, sort_by=sort_by)

    out: list[str] = [_render_header(width, info, sort_by)]

    if width >= 96:
        left_w = width // 2
        right_w = width - left_w - 1
        cpu_box = _render_cpu_box(left_w, cpu, info)
        mem_box = _render_mem_box(right_w, mem)
        disk_box = _render_disk_box(right_w, disks)
        right_col = mem_box + disk_box
        out.extend(merge_columns(cpu_box, right_col, left_w, gap=1))
    else:
        out.extend(_render_cpu_box(width, cpu, info))
        out.extend(_render_mem_box(width, mem))
        out.extend(_render_disk_box(width, disks))

    out.extend(_render_proc_box(width, procs, sort_by))
    out.append(_render_footer(width, cpu.history))
    return "\n".join(out)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="duop-sysmon",
        description="Modern TrueColor system monitor package for Duop.",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Render a single telemetry frame to stdout and exit.",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=1.0,
        help="Refresh interval in seconds (default: 1.0).",
    )
    args = parser.parse_args()

    cpu = CpuSampler()
    proc_sampler = ProcessSampler()
    sort_by = "mem"

    if args.once:
        # Short warmup delta for meaningful CPU% on single-shot run
        time.sleep(0.12)
        cols, rows = RawTerminal.size()
        print(build_frame(cols, rows, cpu, proc_sampler, sort_by))
        return 0

    interval = max(0.25, args.interval)
    try:
        with RawTerminal() as term:
            while True:
                cols, rows = term.size()
                frame = build_frame(cols, rows, cpu, proc_sampler, sort_by)
                sys.stdout.write("\x1b[H\x1b[J" + frame)
                sys.stdout.flush()

                deadline = time.monotonic() + interval
                while True:
                    rem = deadline - time.monotonic()
                    if rem <= 0 or term.resized:
                        term.resized = False
                        break
                    key = term.read_key(min(rem, 0.2))
                    if key is None:
                        continue
                    if key in ("q", "Q", "\x1b", "\x03"):
                        return 0
                    if key in ("c", "C"):
                        sort_by = "cpu"
                        break
                    if key in ("m", "M"):
                        sort_by = "mem"
                        break
                    if key in ("p", "P"):
                        sort_by = "pid"
                        break
                    if key in ("r", "R"):
                        break
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())

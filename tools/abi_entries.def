/* tools/abi_entries.def - single X-macro table of kernel ABI facts shared by abi_verify.c (native run)
 * and tools/abi_cross.py (any --target via compile-time absolute symbols). */
ABI_ENTRY(AT_FDCWD, AT_FDCWD)
ABI_ENTRY(AT_SYMLINK_NOFOLLOW, AT_SYMLINK_NOFOLLOW)
ABI_ENTRY(AT_REMOVEDIR, AT_REMOVEDIR)
ABI_ENTRY(O_RDONLY, O_RDONLY)
ABI_ENTRY(O_WRONLY, O_WRONLY)
ABI_ENTRY(O_RDWR, O_RDWR)
ABI_ENTRY(O_CREAT, O_CREAT)
ABI_ENTRY(O_EXCL, O_EXCL)
ABI_ENTRY(O_TRUNC, O_TRUNC)
ABI_ENTRY(O_APPEND, O_APPEND)
ABI_ENTRY(O_NONBLOCK, O_NONBLOCK)
ABI_ENTRY(O_DIRECTORY, O_DIRECTORY)
ABI_ENTRY(O_NOFOLLOW, O_NOFOLLOW)
ABI_ENTRY(O_CLOEXEC, O_CLOEXEC)
ABI_ENTRY(PROT_READ, PROT_READ)
ABI_ENTRY(PROT_WRITE, PROT_WRITE)
ABI_ENTRY(MAP_SHARED, MAP_SHARED)
ABI_ENTRY(MAP_PRIVATE, MAP_PRIVATE)
ABI_ENTRY(MAP_ANONYMOUS, MAP_ANONYMOUS)
ABI_ENTRY(MAP_FIXED, MAP_FIXED)
ABI_ENTRY(MREMAP_MAYMOVE, MREMAP_MAYMOVE)
ABI_ENTRY(S_IFMT, S_IFMT)
ABI_ENTRY(S_IFDIR, S_IFDIR)
ABI_ENTRY(S_IFREG, S_IFREG)
ABI_ENTRY(S_IFLNK, S_IFLNK)
ABI_ENTRY(EPERM, EPERM)
ABI_ENTRY(ENOENT, ENOENT)
ABI_ENTRY(ESRCH, ESRCH)
ABI_ENTRY(EINTR, EINTR)
ABI_ENTRY(EIO, EIO)
ABI_ENTRY(EBADF, EBADF)
ABI_ENTRY(TIOCGWINSZ, TIOCGWINSZ)
ABI_ENTRY(WINSIZE_ROW, (long long)offsetof(struct winsize, ws_row))
ABI_ENTRY(WINSIZE_COL, (long long)offsetof(struct winsize, ws_col))
ABI_ENTRY(POLLFD_FD, (long long)offsetof(struct pollfd, fd))
ABI_ENTRY(POLLFD_EVENTS, (long long)offsetof(struct pollfd, events))
ABI_ENTRY(POLLFD_REVENTS, (long long)offsetof(struct pollfd, revents))
ABI_ENTRY(POLLIN, POLLIN)
ABI_ENTRY(CLOCK_MONOTONIC, CLOCK_MONOTONIC)
ABI_ENTRY(TIMESPEC_SEC, (long long)offsetof(struct timespec, tv_sec))
ABI_ENTRY(TIMESPEC_NSEC, (long long)offsetof(struct timespec, tv_nsec))
ABI_ENTRY(SIGINT, SIGINT)
ABI_ENTRY(SIGTERM, SIGTERM)
ABI_ENTRY(SIGKILL, SIGKILL)
ABI_ENTRY(SIGCONT, SIGCONT)
ABI_ENTRY(SIGSTOP, SIGSTOP)
ABI_ENTRY(WNOHANG, WNOHANG)
ABI_ENTRY(SIGBUS, SIGBUS)
ABI_ENTRY(SIGWINCH, SIGWINCH)
ABI_ENTRY(KSTAT_SIZE, (long long)sizeof(struct stat))
ABI_ENTRY(KSTAT_DEV, (long long)offsetof(struct stat, st_dev))
ABI_ENTRY(KSTAT_INO, (long long)offsetof(struct stat, st_ino))
ABI_ENTRY(KSTAT_NLINK, (long long)offsetof(struct stat, st_nlink))
ABI_ENTRY(KSTAT_MODE, (long long)offsetof(struct stat, st_mode))
ABI_ENTRY(KSTAT_UID, (long long)offsetof(struct stat, st_uid))
ABI_ENTRY(KSTAT_GID, (long long)offsetof(struct stat, st_gid))
ABI_ENTRY(KSTAT_ST_SIZE, (long long)offsetof(struct stat, st_size))
ABI_ENTRY(KSTAT_MTIME, (long long)offsetof(struct stat, st_mtim))
ABI_ENTRY(KSTAT_MTIME_NSEC, (long long)offsetof(struct stat, st_mtim) + (long long)offsetof(struct timespec, tv_nsec))
ABI_ENTRY(KSTATX_SIZE, (long long)sizeof(struct statx))
ABI_ENTRY(KSTATX_MASK, (long long)offsetof(struct statx, stx_mask))
ABI_ENTRY(KSTATX_MODE, (long long)offsetof(struct statx, stx_mode))
ABI_ENTRY(KSTATX_INO, (long long)offsetof(struct statx, stx_ino))
ABI_ENTRY(KSTATX_ST_SIZE, (long long)offsetof(struct statx, stx_size))
ABI_ENTRY(KSTATX_MTIME, (long long)offsetof(struct statx, stx_mtime))
ABI_ENTRY(KSTATX_DEV_MAJOR, (long long)offsetof(struct statx, stx_dev_major))
ABI_ENTRY(KSTATX_DEV_MINOR, (long long)offsetof(struct statx, stx_dev_minor))
ABI_ENTRY(KDIRENT_INO, (long long)offsetof(struct dirent64, d_ino))
ABI_ENTRY(KDIRENT_RECLEN, (long long)offsetof(struct dirent64, d_reclen))
ABI_ENTRY(KDIRENT_TYPE, (long long)offsetof(struct dirent64, d_type))
ABI_ENTRY(KDIRENT_NAME, (long long)offsetof(struct dirent64, d_name))
#if defined(__x86_64__)
ABI_ENTRY(KUC_RET, offsetof(ucontext_t, uc_mcontext.gregs[REG_RAX]))
ABI_ENTRY(KUC_SP, offsetof(ucontext_t, uc_mcontext.gregs[REG_RSP]))
ABI_ENTRY(KUC_PC, offsetof(ucontext_t, uc_mcontext.gregs[REG_RIP]))
#elif defined(__aarch64__)
ABI_ENTRY(KUC_RET, offsetof(ucontext_t, uc_mcontext.regs[0]))
ABI_ENTRY(KUC_X19, offsetof(ucontext_t, uc_mcontext.regs[19]))
ABI_ENTRY(KUC_SP, offsetof(ucontext_t, uc_mcontext.sp))
ABI_ENTRY(KUC_PC, offsetof(ucontext_t, uc_mcontext.pc))
#endif
ABI_ENTRY(PAL_IN_MODIFY, IN_MODIFY)
ABI_ENTRY(PAL_IN_ATTRIB, IN_ATTRIB)
ABI_ENTRY(PAL_IN_MOVED_FROM, IN_MOVED_FROM)
ABI_ENTRY(PAL_IN_MOVED_TO, IN_MOVED_TO)
ABI_ENTRY(PAL_IN_CREATE, IN_CREATE)
ABI_ENTRY(PAL_IN_DELETE, IN_DELETE)
ABI_ENTRY(PAL_IN_DELETE_SELF, IN_DELETE_SELF)
ABI_ENTRY(PAL_IN_MOVE_SELF, IN_MOVE_SELF)
ABI_ENTRY(PAL_IN_Q_OVERFLOW, IN_Q_OVERFLOW)

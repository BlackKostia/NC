{
  "duop-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/duop_lifecycle.py",
        "timeout": 5
      }
    ]
  },
  "duop-tool-guards": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/duop_lifecycle.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/duop_lifecycle.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "duop-verify-and-commit-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/duop_lifecycle.py",
        "timeout": 5
      }
    ]
  }
}

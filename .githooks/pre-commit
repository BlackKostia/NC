#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "$STAGED" ]]; then
    exit 0
fi

# 1. Forbid staging build outputs or Python caches
BAD_ARTIFACTS="$(printf '%s\n' "$STAGED" | grep -E '^(build/|duop$|nc$|__pycache__/)|\.o$|\.py[co]$' || true)"
if [[ -n "$BAD_ARTIFACTS" ]]; then
    echo "ERROR [pre-commit]: Refusing to commit generated build/cache artifacts:" >&2
    printf '%s\n' "$BAD_ARTIFACTS" >&2
    exit 1
fi

# 2. Prevent partial staging mismatch on tested source/build files
UNSTAGED="$(git diff --name-only)"
CODE_STAGED="$(printf '%s\n' "$STAGED" | grep -E '^(src/|include/|Makefile$|VERSION$|tests/)' || true)"
if [[ -n "$CODE_STAGED" && -n "$UNSTAGED" ]]; then
    MIXED="$(comm -12 <(printf '%s\n' "$CODE_STAGED" | sort) <(printf '%s\n' "$UNSTAGED" | sort) || true)"
    if [[ -n "$MIXED" ]]; then
        echo "ERROR [pre-commit]: Partially staged files would diverge tested tree from commit:" >&2
        printf '%s\n' "$MIXED" >&2
        echo "Stage all changes in those files (git add ...) or stash unstaged edits first." >&2
        exit 1
    fi
fi

# 3. Validate VERSION format, Makefile SRCS sync, layer rules, and i18n symmetry
python3 ./.agents/skills/duop-modular-asm/scripts/check_modularity.py --root "$ROOT"
# 3a. Stack/struct bounds, CFG, syscall-clobber, ABI, OOP vtable & FD/-EINTR reliability audits
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_stack_abi.py
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_cfg_stack.py
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_syscall_clobber.py
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_abi_regs.py
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_oop_vtables.py
python3 ./.agents/skills/duop-reliability-audit/scripts/audit_fd_eintr.py
# 3b. Lean-module budgets (duop-lean-modules ratchet: legacy files may only shrink)
python3 ./.agents/skills/duop-lean-modules/scripts/check_lean.py --root "$ROOT" --staged

VER="$(tr -d '[:space:]' < "$ROOT/VERSION")"

# 4. Enforce continuous SemVer progression whenever src/ or include/ changes
BIN_CODE_STAGED="$(printf '%s\n' "$STAGED" | grep -E '^(src/|include/)' || true)"
if [[ -n "$BIN_CODE_STAGED" ]]; then
    if git rev-parse -q --verify "refs/tags/v${VER}" >/dev/null 2>&1; then
        if [[ "${DUOP_ALLOW_SAME_VERSION:-${NC_ALLOW_SAME_VERSION:-0}}" != "1" ]]; then
            echo "ERROR [pre-commit]: Git tag v${VER} already exists, but src/ or include/ modified!" >&2
            echo "Bump VERSION before committing code changes:" >&2
            echo "  python3 ./.agents/skills/duop-version-release/scripts/bump_version.py --bump patch  # bugfix/refactor" >&2
            echo "  python3 ./.agents/skills/duop-version-release/scripts/bump_version.py --bump minor  # new feature" >&2
            echo "Then 'git add VERSION' and re-run commit (emergency override: DUOP_ALLOW_SAME_VERSION=1)." >&2
            exit 1
        fi
    fi
fi

# 4b. Verify auto-generated docs/SYMBOLS.md is up to date whenever src/ or include/ changes
if [[ -n "$BIN_CODE_STAGED" ]]; then
    python3 "$ROOT/.agents/skills/duop-docs-sync/scripts/gen_symbols_catalog.py" --check
fi

# 4c. Warn when feature/UI/extension modules are staged without documentation updates
FEATURE_STAGED="$(printf '%s\n' "$STAGED" | grep -E '^(src/app/|src/ui/|src/fs/pkg_|src/main\.s)' || true)"
DOCS_STAGED="$(printf '%s\n' "$STAGED" | grep -E '^(docs/|README(\.uk)?\.md$|ROADMAP\.md$)' || true)"
if [ -n "$FEATURE_STAGED" ] && [ -z "$DOCS_STAGED" ]; then
    echo "WARN [docs-hook]: Feature/UI/package files staged without any docs/ or ROADMAP.md update:" >&2
    printf '%s\n' "$FEATURE_STAGED" | sed 's/^/  /' >&2
    echo "  If user-facing behavior, hotkeys, or extension contracts changed, see .agents/skills/duop-docs-sync/SKILL.md." >&2
fi

# 5. Build stripped release binary, verify ELF .data==0 & --version, and run PTY suite
NEEDS_BUILD="$(printf '%s\n' "$STAGED" | grep -E '^(src/|include/|Makefile$|VERSION$|tests/.*\.py$)' || true)"
if [[ -n "$NEEDS_BUILD" && "${DUOP_SKIP_PTY_HOOK:-${NC_SKIP_PTY_HOOK:-0}}" != "1" ]]; then
    echo "[pre-commit] Running release build + ELF audit + PTY test suite..."
    # Git exports GIT_DIR/GIT_INDEX_FILE to hooks: tests that build scratch repos (and duop's own
    # `git status`) must not inherit them, or they would write into this repository's config/index.
    HOOK_MODE="--smart"
    if [[ "${DUOP_FULL_PTY_HOOK:-0}" == "1" ]]; then
        HOOK_MODE="--release-only"
    fi
    env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX -u GIT_COMMON_DIR \
        DUOP_LEAN_STAGED=1 ./.agents/skills/duop-pty-verify/scripts/verify_build.sh "$HOOK_MODE"
fi
